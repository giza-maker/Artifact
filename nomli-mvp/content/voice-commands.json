{
  "schemaVersion": 1,
  "notes": "Authored utterances for intent and confirmation-flow tests. They are not speech-recognition benchmarks.",
  "confirmationPolicy": {
    "alwaysConfirm": [
      "inventory.remove",
      "inventory.set_expiry",
      "shopping.clear",
      "cook.stop",
      "agent.purchase_or_order",
      "inventory.add",
      "inventory.adjust",
      "shopping.add"
    ],
    "confirmWhenAmbiguous": [
      "recipe.start",
      "timer.set"
    ],
    "noConfirmationNormally": [
      "inventory.query",
      "recipe.search",
      "timer.query",
      "help"
    ]
  },
  "examples": [
    {
      "id": "vc_en_001",
      "locale": "en",
      "utterance": "Add six eggs to my fridge",
      "expected": {
        "intent": "inventory.add",
        "slots": {
          "ingredientId": "egg",
          "quantity": 6,
          "unit": "piece",
          "storage": "fridge"
        }
      },
      "confirmation": "required",
      "reason": "Preview parsed quantity and target; user confirms before any state change."
    },
