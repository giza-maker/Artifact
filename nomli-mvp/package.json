{
  "name": "nomli-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node --check web/app.js && node --check web/data.js && node --test tests/*.test.mjs && node scripts/validate-content.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "manifest": "node scripts/asset-manifest.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@supabase/supabase-js": "2.118.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "openai": "7.43.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
